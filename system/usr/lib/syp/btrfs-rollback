#!/bin/bash
# Setzt das System auf einen syp-Snapshot zurück (btrfs-Backend, »syp rollback --system«).
#
#   btrfs-rollback /.snapshots/syp-<zeit>-pre
#
# Aufbau wie vom Installer angelegt: Wurzel = Subvolume @ (fstab: subvol=@), Snapshots in @snapshots.
# Vorgehen: oberste Ebene einhängen, @ in @.vor-rollback-<zeit> umbenennen, beschreibbare Kopie des Snapshots
# als neues @ anlegen. Das laufende System bleibt bis zum Neustart unverändert; danach startet der alte Stand.
# Der bisherige Stand bleibt als @.vor-rollback-<zeit> erhalten (löschen: btrfs subvolume delete …).
set -euo pipefail
snap=${1:?Snapshot fehlt}
[[ $EUID -eq 0 ]] || { echo "Bitte als root ausführen" >&2; exit 1; }
name=$(basename "$snap")
[[ $name == syp-* ]] || { echo "Kein syp-Snapshot: $snap" >&2; exit 1; }
dev=$(findmnt -nvo SOURCE /)
[[ $(findmnt -no FSTYPE /) == btrfs ]] || { echo "/ ist kein Btrfs" >&2; exit 1; }
# Einhängepunkt unter /mnt: dessen SELinux-Typ mnt_t ist für Mounts vorgesehen; auf ein von uns in /run
# angelegtes Verzeichnis darf mount (mount_t) unter enforcing nicht einhängen
base=/mnt; [[ -d $base ]] || base=/run
top=$(mktemp -d "$base/.syp-rollback.XXXXXX")
trap 'umount "$top" 2>/dev/null; rmdir "$top" 2>/dev/null' EXIT
# Oberste Ebene einhängen. Mehrere Wege: je nach util-linux/Kernel lehnt der zweite Mount desselben
# Dateisystems eine Variante mit EBUSY (»bereits eingehängt«) ab. Optionen der Wurzel ohne Subvolume-Angaben.
opts=$(findmnt -no OPTIONS / | tr ',' '\n' | grep -vE '^(subvol=|subvolid=|seclabel$)' | paste -sd, -)
mounted=0
uuid=$(findmnt -no UUID / || true)
for src in ${uuid:+"UUID=$uuid"} "$dev"; do
  for try in "subvol=/" "subvolid=5" "mount2:subvolid=5"; do
    env=(); o=${try#mount2:}
    [[ $try == mount2:* ]] && env=(LIBMOUNT_FORCE_MOUNT2=always)
    if env "${env[@]}" mount -t btrfs -o "${opts:+$opts,}$o" "$src" "$top"; then mounted=1; break 2; fi
    echo "Einhängen von $src mit $try fehlgeschlagen" >&2
  done
done
if ((!mounted)); then
  findmnt -o TARGET,SOURCE,FSROOT,OPTIONS -t btrfs >&2 || true
  dmesg 2>/dev/null | grep -iE 'btrfs|selinux|mount' | tail -5 >&2
  echo "Oberste Btrfs-Ebene von $dev lässt sich nicht einhängen; nichts verändert" >&2; exit 1
fi
[[ -d $top/@ && -d $top/@snapshots/$name ]] || {
  echo "Unerwarteter Aufbau: $top/@ oder $top/@snapshots/$name fehlt" >&2; exit 1; }
old="@.vor-rollback-$(date +%Y%m%d-%H%M%S)"
mv "$top/@" "$top/$old"
if ! btrfs -q subvolume snapshot "$top/@snapshots/$name" "$top/@"; then
  mv "$top/$old" "$top/@"
  echo "Snapshot konnte nicht angelegt werden; nichts verändert" >&2; exit 1
fi
sync
echo "Zurückgesetzt auf $name. Bitte neu starten."
echo "Bisheriger Stand: Subvolume $old (nach erfolgreichem Neustart löschbar)."
