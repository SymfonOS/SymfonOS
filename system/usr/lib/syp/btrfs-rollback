#!/bin/bash
# Setzt das System auf einen syp-Snapshot zurück (btrfs-Backend, »syp rollback --system«).
#
#   btrfs-rollback /.snapshots/syp-<zeit>-pre
#
# Aufbau wie vom Installer angelegt: Wurzel = Subvolume @ (fstab: subvol=@), Snapshots in @snapshots.
# Vorgehen: oberste Ebene einhängen, @ in @.vor-rollback-<zeit> umbenennen, beschreibbare Kopie des Snapshots
# als neues @ anlegen. Das laufende System bleibt bis zum Neustart unverändert; danach startet der alte Stand.
# Der bisherige Stand bleibt als @.vor-rollback-<zeit> erhalten (löschen: btrfs subvolume delete …).
set -euo pipefail
snap=${1:?Snapshot fehlt}
[[ $EUID -eq 0 ]] || { echo "Bitte als root ausführen" >&2; exit 1; }
name=$(basename "$snap")
[[ $name == syp-* ]] || { echo "Kein syp-Snapshot: $snap" >&2; exit 1; }
dev=$(findmnt -nvo SOURCE /)
[[ $(findmnt -no FSTYPE /) == btrfs ]] || { echo "/ ist kein Btrfs" >&2; exit 1; }
top=$(mktemp -d /run/syp-rollback.XXXXXX)
trap 'umount "$top" 2>/dev/null; rmdir "$top"' EXIT
mount -o subvolid=5 "$dev" "$top"
[[ -d $top/@ && -d $top/@snapshots/$name ]] || {
  echo "Unerwarteter Aufbau: $top/@ oder $top/@snapshots/$name fehlt" >&2; exit 1; }
old="@.vor-rollback-$(date +%Y%m%d-%H%M%S)"
mv "$top/@" "$top/$old"
if ! btrfs -q subvolume snapshot "$top/@snapshots/$name" "$top/@"; then
  mv "$top/$old" "$top/@"
  echo "Snapshot konnte nicht angelegt werden; nichts verändert" >&2; exit 1
fi
sync
echo "Zurückgesetzt auf $name. Bitte neu starten."
echo "Bisheriger Stand: Subvolume $old (nach erfolgreichem Neustart löschbar)."
