policy_module(symfonos, 1.2)

# Ergänzungen zur Reference Policy 2025.02 für symfonOS (systemd 257, Plasma 6, SDDM, CUPS, Live-Medium).
# Entstanden aus den Verweigerungen des Desktop-Tests (tools/avc-summary.py, Branch ci-diag: avc.txt).
# Ziel: Live-System und installierter Desktop ohne Verweigerungen im Modus enforcing.

gen_require(`
	attribute domain;
	type kernel_t, tmpfs_t, cgroup_t, nsfs_t, usr_t, bin_t, lib_t, etc_t, boot_t, debugfs_t;
	type devlog_t, syslogd_runtime_t, user_home_dir_t, ssh_home_t, user_tmpfs_t;
	type syslogd_t, systemd_nsresourced_t, systemd_resolved_t, systemd_logind_t, systemd_hw_t;
	type systemd_hostnamed_t, systemd_tmpfiles_t, auditctl_t, auditd_log_t, policykit_t;
	type systemd_user_manager_unit_t, xdm_t, xdm_var_lib_t, unconfined_t, system_dbusd_t;
	type cupsd_t, cupsd_rw_etc_t;
	type ntpd_t, udev_t, iso9660_t, systemd_networkd_var_lib_t, NetworkManager_t;
	type systemd_sessions_runtime_t, systemd_logind_runtime_t, systemd_machined_runtime_t;
	type devicekit_disk_t, mount_runtime_t, systemd_locale_t;
	class dir { getattr search open read watch add_name write relabelfrom relabelto };
	class file { getattr open read write execmod relabelfrom relabelto };
	class lnk_file { getattr read };
	class fd use;
	class process { execmem execstack };
	class capability { dac_override net_admin };
	class capability2 perfmon;
	class unix_dgram_socket { create connect getopt setopt write sendto };
	class sock_file write;
	class service status;
	class dbus { acquire_svc send_msg };
')

########################################
# Live-Medium: dracut hängt das Overlay ein, bevor die Richtlinie geladen ist. Die Wurzel »/« trägt deshalb das
# Label der tmpfs-Oberschicht (tmpfs_t), und Dateien aus dem Overlay gehören zu Deskriptoren von kernel_t.
# Ohne diese Regeln starten im Modus enforcing weder journald noch udev. Im installierten System ist »/« root_t.
allow domain tmpfs_t:dir { getattr search open read watch };
allow domain kernel_t:fd use;
# udev prüft das Abbild des Live-Mediums auf der CD
allow udev_t iso9660_t:file getattr;

########################################
# systemd ≥ 254: Dienste lesen den Speicherdruck ihrer cgroup (memory.pressure)
allow { syslogd_t systemd_nsresourced_t systemd_resolved_t systemd_logind_t ntpd_t } cgroup_t:file { getattr open read write };

# systemd-nsresourced (neu in systemd 256) lädt BPF-Programme
allow systemd_nsresourced_t self:capability2 perfmon;

# systemd-resolved liest die Krypto-Richtlinie (/usr/share/crypto-policies, OpenSSL-Konfiguration)
allow systemd_resolved_t usr_t:file { getattr open read };

# systemd-hwdb protokolliert ins Journal und prüft seinen Namensraum
allow systemd_hw_t self:unix_dgram_socket { create connect getopt setopt write };
allow systemd_hw_t kernel_t:unix_dgram_socket sendto;
allow systemd_hw_t devlog_t:sock_file write;
allow systemd_hw_t syslogd_runtime_t:dir search;
allow systemd_hw_t self:capability { dac_override net_admin };
allow { systemd_hw_t systemd_hostnamed_t } nsfs_t:file getattr;

# systemd-tmpfiles setzt Labels nach (Z/z-Zeilen: /root, ~/.ssh, /var/lib/sddm, dbus-daemon-launch-helper)
allow systemd_tmpfiles_t bin_t:dir search;
allow systemd_tmpfiles_t bin_t:lnk_file { getattr read };
allow systemd_tmpfiles_t { user_home_dir_t ssh_home_t xdm_var_lib_t auditd_log_t systemd_networkd_var_lib_t }:dir { relabelfrom relabelto };
allow systemd_tmpfiles_t lib_t:file { relabelfrom relabelto };

# auditctl liest beim Laden der Regeln /var/log/audit
allow auditctl_t auditd_log_t:dir { getattr search open read };

# systemd-logind prüft /boot (Neustart in die Firmware, Bootloader-Einträge)
allow systemd_logind_t boot_t:dir { getattr search };

########################################
# Desktop: Qt/QML erzeugen Code zur Laufzeit (JIT) – Anmeldebildschirm, Sitzung, KAuth-Helfer von powerdevil
allow xdm_t self:process execmem;
allow unconfined_t self:process { execmem execstack };
allow unconfined_t user_tmpfs_t:file execmod;
allow system_dbusd_t self:process execmem;
# discretegpuhelper sucht in debugfs nach GPUs; ohne Zugriff kein Unterschied
dontaudit system_dbusd_t debugfs_t:dir search;

# polkit fragt den Zustand der Benutzerdienste (user@.service) ab
allow policykit_t systemd_user_manager_unit_t:service status;

# CUPS legt /etc/printcap an
type_transition cupsd_t etc_t:file cupsd_rw_etc_t "printcap";
allow cupsd_t etc_t:dir { add_name write };

########################################
# Anmeldung: logind (systemd ≥ 256) übernimmt den pidfd des Anmeldeprozesses; die Reference Policy erlaubt das
# nur für sshd und login, nicht für den Anmeldebildschirm. Ohne Regel trennt sd-bus logind beim Empfang des
# Deskriptors vom Bus (pam_systemd: »Message recipient disconnected«) und die Plasma-Sitzung startet nicht.
allow { systemd_logind_t system_dbusd_t } xdm_t:fd use;

# NetworkManager beobachtet Sitzungen und Benutzer über /run/systemd (sonst »logind monitor: -13«)
allow NetworkManager_t { systemd_sessions_runtime_t systemd_logind_runtime_t systemd_machined_runtime_t }:dir watch;

# udisks beobachtet /run/mount (Einhängepunkte)
allow devicekit_disk_t mount_runtime_t:dir watch;

# systemd-localed antwortet der Sitzung (Tastaturbelegung)
allow systemd_locale_t unconfined_t:dbus send_msg;
