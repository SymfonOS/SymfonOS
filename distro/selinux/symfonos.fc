# SDDM startet die Sitzung über diese Skripte; als usr_t sind sie kein Einstiegspunkt für unconfined_t
/usr/share/sddm/scripts(/.*)?	gen_context(system_u:object_r:bin_t,s0)
# Flatpak-Systemhelfer (eigene Domäne, siehe symfonos.te)
/usr/libexec/flatpak-system-helper	--	gen_context(system_u:object_r:flatpak_helper_exec_t,s0)
/usr/lib/flatpak-system-helper	--	gen_context(system_u:object_r:flatpak_helper_exec_t,s0)
