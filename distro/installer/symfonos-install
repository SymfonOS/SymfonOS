#!/usr/bin/env bash
# symfonos-install – installiert symfonOS vom Live-Medium (offline aus dem Repo auf dem ISO).
#   sudo symfonos-install [--disk /dev/nvme0n1] [--no-encrypt] [--tpm] [--boot systemd-boot|grub]
#                         [--user NAME] [--hostname NAME] [--yes]
# Layout: GPT mit BIOS-Boot (1 MiB), EFI (1 GiB, FAT32), Btrfs (Rest, standardmäßig in LUKS2)
# Btrfs-Subvolumes: @ @home @snapshots @var_log @cache – Pakete und Snapshots verwaltet syp.
# UEFI: systemd-boot mit signierbaren Unified Kernel Images (Secure Boot: symfonos-secureboot),
#       LUKS2 mit Argon2id. BIOS bzw. --boot grub: GRUB, LUKS2 mit PBKDF2 (GRUB kennt kein Argon2).
# --tpm: Entsperren über TPM 2.0 (an PCR 7 = Secure-Boot-Zustand gebunden) plus Wiederherstellungsschlüssel.
set -euo pipefail
DISK="" ENCRYPT=1 TPM=0 BOOT="" USERNAME="" HOST=symfonos YES=0
REPO=${SYMFONOS_REPO:-/run/initramfs/live/repo}
MNT=/mnt/symfonos-target
while (($#)); do
  case $1 in
    --disk) DISK=$2; shift 2 ;; --encrypt) ENCRYPT=1; shift ;; --no-encrypt) ENCRYPT=0; shift ;;
    --tpm) TPM=1; shift ;; --boot) BOOT=$2; shift 2 ;; --user) USERNAME=$2; shift 2 ;;
    --hostname) HOST=$2; shift 2 ;; --yes|-y) YES=1; shift ;; --repo) REPO=$2; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unbekannte Option: $1" >&2; exit 2 ;;
  esac
done
[[ $EUID -eq 0 ]] || { echo "Bitte mit sudo ausführen." >&2; exit 1; }
# Quelle: Paket-Repository auf dem Medium (falls vorhanden) oder das laufende Live-System selbst
LIVE_ROOT=${SYMFONOS_LIVE_ROOT:-/run/rootfsbase}
if [[ -r $REPO/index.json.zst ]]; then SOURCE=repo
elif [[ -d $LIVE_ROOT/usr/bin && -d $LIVE_ROOT/var/lib/syp ]]; then SOURCE=live
else echo "Weder Paket-Repository ($REPO) noch Live-System ($LIVE_ROOT) gefunden" >&2; exit 1; fi
say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }
ask() { local a; read -rp "$1 " a; printf '%s' "$a"; }

if [[ -z $DISK ]]; then
  echo "Verfügbare Datenträger:"; lsblk -dpno NAME,SIZE,MODEL | grep -Ev 'loop|sr[0-9]|zram'
  DISK=$(ask "Zieldatenträger (z. B. /dev/nvme0n1):")
fi
[[ -b $DISK ]] || { echo "Kein Blockgerät: $DISK" >&2; exit 1; }
[[ -z $USERNAME ]] && USERNAME=$(ask "Benutzername:")
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "Ungültiger Benutzername" >&2; exit 1; }
if ((!YES)); then
  echo "ALLE DATEN auf $DISK werden gelöscht."
  [[ $(ask "Zum Bestätigen den Gerätenamen eintippen ($DISK):") == "$DISK" ]] || { echo "Abgebrochen."; exit 1; }
fi
part() { [[ $DISK =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }
UEFI=0; [[ -d /sys/firmware/efi ]] && UEFI=1
NONVRAM="" NOVARS=""
[[ ${SYMFONOS_NO_NVRAM:-0} == 1 ]] && NONVRAM=--no-nvram NOVARS=--no-variables
[[ -z $BOOT ]] && { ((UEFI)) && BOOT=systemd-boot || BOOT=grub; }
[[ $BOOT == systemd-boot || $BOOT == grub ]] || { echo "--boot: systemd-boot oder grub" >&2; exit 2; }
[[ $BOOT == systemd-boot && $UEFI == 0 ]] && { echo "systemd-boot braucht UEFI" >&2; exit 1; }
if ((TPM)); then
  ((ENCRYPT)) || { echo "--tpm setzt Verschlüsselung voraus" >&2; exit 1; }
  [[ -e /sys/class/tpm/tpm0 ]] || { echo "Kein TPM 2.0 gefunden" >&2; exit 1; }
  if [[ $(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ') != 1 ]]; then
    echo "Hinweis: Secure Boot ist aus. Die TPM-Bindung an PCR 7 schützt dann kaum; nach der Einrichtung von"
    echo "Secure Boot (symfonos-secureboot) neu binden: systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=7"
  fi
fi

say "Partitionieren ($( ((UEFI)) && echo UEFI || echo BIOS ))"
wipefs -af "$DISK" >/dev/null
sfdisk --quiet "$DISK" <<PARTS
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="bios"
size=1GiB, type=U, name="EFI"
type=L, name="symfonOS"
PARTS
# Partitionstabelle neu einlesen und auf die Gerätedateien warten (ohne udev dauert das einen Moment)
blockdev --rereadpt "$DISK" 2>/dev/null || true
partx -u "$DISK" 2>/dev/null || true   # meldet neue Partitionen auch dort, wo --rereadpt still nichts bewirkt
udevadm settle 2>/dev/null || true
for _ in $(seq 50); do [[ -b $(part 3) ]] && break; sleep 0.2; done
if [[ ! -b $(part 3) ]]; then
  # Ohne udev legt niemand die Knoten an: aus sysfs nachholen
  for n in 1 2 3; do
    p=$(part "$n"); s=/sys/class/block/$(basename "$p")/dev
    [[ -b $p || ! -r $s ]] || mknod "$p" b "$(cut -d: -f1 "$s")" "$(cut -d: -f2 "$s")"
  done
fi
[[ -b $(part 3) ]] || { echo "Partitionen auf $DISK erscheinen nicht" >&2; exit 1; }
EFI=$(part 2) ROOT=$(part 3) ROOTDEV=$(part 3)
mkfs.fat -F32 -n EFI "$EFI" >/dev/null
if ((ENCRYPT)); then
  # GRUB entsperrt LUKS2 nur mit PBKDF2; mit systemd-boot entsperrt das Initramfs (Argon2id, speicherhart)
  PBKDF=argon2id; [[ $BOOT == grub ]] && PBKDF=pbkdf2
  say "Verschlüsselung (LUKS2, AES-256-XTS, $PBKDF)"
  cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 --key-size 512 --hash sha512 --pbkdf "$PBKDF" \
    --use-random --batch-mode --verify-passphrase "$ROOT"
  cryptsetup open "$ROOT" cryptroot
  ROOTDEV=/dev/mapper/cryptroot
fi
mkfs.btrfs -f -L symfonOS "$ROOTDEV" >/dev/null
mkdir -p "$MNT"; mount "$ROOTDEV" "$MNT"
for sv in @ @home @snapshots @var_log @cache; do btrfs subvolume create "$MNT/$sv" >/dev/null; done
umount "$MNT"
OPT=noatime,compress=zstd:1
mount -o "$OPT,subvol=@" "$ROOTDEV" "$MNT"
ESPDIR=/boot/efi; [[ $BOOT == systemd-boot ]] && ESPDIR=/efi
mkdir -p "$MNT"/{home,.snapshots,var/log,var/cache} "$MNT$ESPDIR"
mount -o "$OPT,subvol=@home" "$ROOTDEV" "$MNT/home"
mount -o "$OPT,subvol=@snapshots" "$ROOTDEV" "$MNT/.snapshots"
mount -o "$OPT,subvol=@var_log" "$ROOTDEV" "$MNT/var/log"
mount -o "$OPT,subvol=@cache" "$ROOTDEV" "$MNT/var/cache"
mount -o umask=0077 "$EFI" "$MNT$ESPDIR"
cleanup() { for m in run sys proc dev; do mountpoint -q "$MNT/$m" && umount -l "$MNT/$m"; done; true; }
trap cleanup EXIT

if [[ $SOURCE == repo ]]; then
  say "Pakete installieren (syp, offline)"
  mkdir -p "$MNT/etc/syp/keys"
  cp "$REPO/symfonos-release.pub" "$MNT/etc/syp/keys/"
  printf 'arch = "x86_64"\n[[repo]]\nname = "symfonos"\nurl = "file://%s"\n[snapshots]\nenabled = false\n' "$REPO" > "$MNT/etc/syp/syp.toml"
  syp -r "$MNT" sync
  syp -r "$MNT" -y install --overwrite /etc/syp/syp.toml symfonos-base   # vorläufige Offline-Konfiguration ersetzen
  cp /etc/syp/syp.toml "$MNT/etc/syp/syp.toml"   # Online-Repos für Updates
else
  # Das Live-System ist mit syp aus signierten Paketen gebaut; seine Paketdatenbank wird mitkopiert,
  # das installierte System ist also genauso verwaltbar und aktualisierbar.
  say "System kopieren (Live-System inkl. Paketdatenbank und SELinux-Labels)"
  cp -a --preserve=all "$LIVE_ROOT/." "$MNT/"
  # Nur für das Live-Medium gedachte Einstellungen entfernen
  rm -f "$MNT/etc/sudoers.d/90-live" "$MNT/etc/motd"
  rm -rf "$MNT/etc/systemd/system/getty@tty1.service.d"
  if grep -q '^live:' "$MNT/etc/passwd"; then chroot "$MNT" userdel -r live 2>/dev/null || chroot "$MNT" userdel live; fi
  : > "$MNT/etc/machine-id"
  rm -f "$MNT"/etc/ssh/ssh_host_*
  syp -r "$MNT" verify >/dev/null || echo "Hinweis: syp verify meldet Abweichungen (Live-Anpassungen)"
fi

say "System konfigurieren"
for m in dev proc sys run; do mount --bind "/$m" "$MNT/$m"; done
uuid() { blkid -s UUID -o value "$1"; }
RU=$(uuid "$ROOTDEV")
{
  echo "UUID=$RU / btrfs $OPT,subvol=@ 0 0"
  echo "UUID=$RU /home btrfs $OPT,subvol=@home 0 0"
  echo "UUID=$RU /.snapshots btrfs $OPT,subvol=@snapshots 0 0"
  echo "UUID=$RU /var/log btrfs $OPT,subvol=@var_log 0 0"
  echo "UUID=$RU /var/cache btrfs $OPT,subvol=@cache 0 0"
  echo "UUID=$(uuid "$EFI") $ESPDIR vfat umask=0077,shortname=winnt 0 2"
} > "$MNT/etc/fstab"
echo "$HOST" > "$MNT/etc/hostname"
cp /etc/locale.conf /etc/vconsole.conf "$MNT/etc/" 2>/dev/null || true
ln -sf "../usr/share/zoneinfo/${TZ_NAME:-Europe/Berlin}" "$MNT/etc/localtime"
CMDLINE="rootflags=subvol=@"
if ((ENCRYPT)); then
  LU=$(uuid "$ROOT")
  CRYPTOPT=luks; ((TPM)) && CRYPTOPT=luks,tpm2-device=auto
  echo "cryptroot UUID=$LU none $CRYPTOPT" > "$MNT/etc/crypttab"
  chmod 600 "$MNT/etc/crypttab"
  CMDLINE="rd.luks.uuid=$LU rd.luks.name=$LU=cryptroot $CMDLINE"
  ((TPM)) && CMDLINE="$CMDLINE rd.luks.options=$LU=tpm2-device=auto"
  if [[ $BOOT == grub ]]; then
    sed -i 's/^#\?GRUB_ENABLE_CRYPTODISK=.*//' "$MNT/etc/default/grub"
    echo 'GRUB_ENABLE_CRYPTODISK=y' >> "$MNT/etc/default/grub"
  fi
fi
sed -i "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$CMDLINE\"|" "$MNT/etc/default/grub"
# Gemeinsame Härtungsparameter (Paket symfonos-security), für UKI fest eingebettet
HARDEN=$(cat "$MNT/usr/lib/symfonos/kernel-cmdline" 2>/dev/null || true)
install -d "$MNT/etc/kernel"
echo "root=UUID=$RU rw $CMDLINE $HARDEN" > "$MNT/etc/kernel/cmdline"
((TPM)) && echo 'add_dracutmodules+=" tpm2-tss "' > "$MNT/etc/dracut.conf.d/50-tpm2.conf"
in_target() { chroot "$MNT" /usr/bin/env -i PATH=/usr/bin:/usr/sbin HOME=/root /bin/bash -euo pipefail -c "$1"; }
in_target "systemd-machine-id-setup >/dev/null; systemd-sysusers; systemd-tmpfiles --create >/dev/null 2>&1 || true
  useradd -m -G wheel,audio,video,input -s /bin/bash '$USERNAME'
  passwd -l root >/dev/null
  systemctl preset-all >/dev/null 2>&1 || true
  # Pflichtdienste (Netz, Firewall, Audit) müssen sich aktivieren lassen; optionale nur mit Hinweis
  systemctl enable systemd-networkd systemd-resolved systemd-timesyncd nftables auditd symfonos-security-check.timer >/dev/null
  for u in iwd.service fstrim.timer; do systemctl enable \"\$u\" >/dev/null 2>&1 || echo \"Hinweis: \$u nicht vorhanden\"; done
  # SELinux: Anmeldungen wie bei Fedora unconfined_u zuordnen (Desktop, QEMU/KVM, Browser-Sandboxen)
  if command -v semanage >/dev/null; then semanage login -m -s unconfined_u -r s0-s0:c0.c1023 __default__ 2>/dev/null || true; fi"
# SYMFONOS_PASSWORD: nicht-interaktiv (automatische Installationstests); sonst interaktiv
if [[ -n ${SYMFONOS_PASSWORD:-} ]]; then printf '%s:%s\n' "$USERNAME" "$SYMFONOS_PASSWORD" | chroot "$MNT" chpasswd
else echo "Passwort für $USERNAME:"; chroot "$MNT" passwd "$USERNAME"; fi
echo "Root-Konto bleibt gesperrt; Verwaltung über sudo (Gruppe wheel)."
say "Bootloader ($BOOT) und Kernel"
if [[ $BOOT == systemd-boot ]]; then
  in_target "bootctl --esp-path=/efi install $NOVARS >/dev/null
    printf 'timeout 3\\neditor no\\nconsole-mode auto\\n' > /efi/loader/loader.conf
    /usr/lib/syp/kernel-hook"
else
  in_target "/usr/lib/syp/kernel-hook"
  if ((UEFI)); then
    in_target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=symfonOS $NONVRAM
      grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable"
  fi
  in_target "grub-install --target=i386-pc '$DISK'"
  in_target "grub-mkconfig -o /boot/grub/grub.cfg"
fi

if ((TPM)); then
  say "TPM 2.0 einbinden und Wiederherstellungsschlüssel erzeugen"
  echo "Bitte die eben gewählte Passphrase eingeben:"
  systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$ROOT"
  echo; echo "WIEDERHERSTELLUNGSSCHLÜSSEL – aufschreiben und getrennt vom Gerät aufbewahren:"
  systemd-cryptenroll --recovery-key "$ROOT"
  echo
fi

say "SELinux-Dateikontexte setzen"
FC=$MNT/etc/selinux/refpolicy/contexts/files/file_contexts
if [[ -r $FC ]] && command -v setfiles >/dev/null; then
  setfiles -r "$MNT" -e "$MNT/proc" -e "$MNT/sys" -e "$MNT/dev" -e "$MNT/run" -e "$MNT$ESPDIR" -F "$FC" "$MNT" \
    || { echo "setfiles fehlgeschlagen – Kontexte werden beim ersten Start gesetzt"; touch "$MNT/.autorelabel"; }
else
  touch "$MNT/.autorelabel"
fi
cleanup
umount -R "$MNT"
((ENCRYPT)) && cryptsetup close cryptroot
say "Fertig. Medium entfernen und neu starten."
