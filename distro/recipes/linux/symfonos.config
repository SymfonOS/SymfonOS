# symfonOS-Kernelfragment (wird an defconfig angehängt, dann olddefconfig)
# --- Allgemein / Sicherheit
CONFIG_LOCALVERSION="-symfonos"
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_ZSTD=y
# --- systemd-Voraussetzungen
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_PSI=y
# --- Dateisysteme (Btrfs als Standard, Live-System: squashfs + overlay)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=m
CONFIG_FUSE_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
# --- Verschlüsselung / LVM
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=m
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
# --- UEFI / Hardware
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_FB_EFI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_HID_GENERIC=y
CONFIG_HID_WACOM=m
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
# --- Grafik
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
# --- Audio (Echtzeit-Audio für Musikproduktion)
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SEQUENCER=m
CONFIG_HIGH_RES_TIMERS=y
# --- Netzwerk / Bluetooth / WLAN
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH11K=m
CONFIG_MT7921E=m
CONFIG_RTW89=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NF_TABLES_INET=y
CONFIG_WIREGUARD=m
