# symfonOS-Krypto-Richtlinie FUTURE für OpenSSL – erzeugt, nicht von Hand bearbeiten
CipherString = @SECLEVEL=3:kEECDH:kEDH:-aDSS:!3DES:!DES:!RC4:!RC2:!IDEA:!SEED:!eNULL:!aNULL:!MD5:!SHA1:!CAMELLIA:!ARIA:!AESCCM8:!kRSA:!CBC
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
MinProtocol = TLSv1.2
Groups = X25519MLKEM768:X25519:X448:secp521r1:secp384r1:ffdhe3072:ffdhe4096
SignatureAlgorithms = ed25519:ed448:ecdsa_secp384r1_sha384:ecdsa_secp521r1_sha512:rsa_pss_pss_sha384:rsa_pss_pss_sha512:rsa_pss_rsae_sha384:rsa_pss_rsae_sha512
