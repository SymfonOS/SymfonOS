# symfonOS-Krypto-Richtlinie LEGACY für OpenSSL – erzeugt, nicht von Hand bearbeiten
CipherString = @SECLEVEL=1:kEECDH:kRSA:kEDH:kPSK:kDHEPSK:kECDHEPSK:-aDSS:!DES:!RC4:!RC2:!IDEA:-SEED:!eNULL:!aNULL:!MD5:-CAMELLIA:-ARIA:-AESCCM8
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
MinProtocol = TLSv1.2
Groups = X25519MLKEM768:X25519:secp256r1:X448:secp521r1:secp384r1:ffdhe2048:ffdhe3072:ffdhe4096:ffdhe6144:ffdhe8192
